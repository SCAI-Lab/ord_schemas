{
    "$schema": "http://json-schema.org/draft-07/schema#",

    "title": "EEG Data Series",
    "type": "object",
    "description": "This schema represents an eeg data series, i.e., an array of measures that share the same header.",

    "definitions": {
        "header": {
            "$ref": "sensor-device-header-1.x.json"
        },

        "eeg_body": {
            "$ref": "eeg-1.x.json"
        },

        "electrode_site_enum": {
            "type": "string",
            "enum": [
                "fp1", "fp2", "f3", "f4", "c3", "c4", "p3", "p4", "o1", "o2",
                "f7", "f8", "t3", "t4", "t5", "t6", "fz", "cz", "pz", "oz", "custom"
            ]
        },

        "filter_base": {
            "$ref": "filter-base-1.x.json"
        }
    },

    "properties": {
        "header": {
            "description": "The header of the data point.",
            "type": "object",
            "allOf": [
                {"$ref": "#/definitions/header"},
                {
                    "type": "object",
                    "properties": {
                        "eeg_info": {
                            "type": "object",
                            "properties": {
                                "channel_size": {
                                    "type": "integer"
                                },

                                "selected_preprocessing": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "bandpass", "notch", "ica", "car", "artefact_rej",
                                            "baseline_corr", "downsample", "segmented", "custom"
                                        ]
                                    }
                                },

                                "montage_type": {
                                    "type": "string",
                                    "enum": [
                                        "bipolar", "referential", "average_ref", "laplacian"
                                    ]
                                },

                                "bipolar_active_sites": {
                                    "description": "Only used if montage_type=bipolar; length = channel_count",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/electrode_site_enum"
                                    }
                                },

                                "bipolar_reference_sites": {
                                    "description": "Only used if montage_type=bipolar; length = channel_count",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/electrode_site_enum"
                                    }
                                },

                                "reference_sites": {
                                    "description": "Only used if montage_type=referential or average_ref",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/electrode_site_enum"
                                    }
                                },

                                "placement_method": {
                                    "description": "Support multiple placements",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "10-20", "10-10", "10-5", "custom"
                                        ]
                                    }
                                },

                                "electrode_sites": {
                                    "description": "One per channel, in the order used in eeg[] data",
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/definitions/electrode_site_enum"
                                    }
                                },

                                "electrode_physical_type": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "agcl", "gold_cup", "dry", "wet", "hydrogel", "microneedle", "custom"
                                        ]
                                    }
                                },

                                "signal_mode": {
                                    "type": "string",
                                    "enum": [
                                        "surface", "intracranial", "custom"
                                    ]
                                },

                                "filters": {
                                    "$ref": "#/definitions/filter_base"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "body": {
            "$ref": "#/definitions/eeg_body"
        }
    },

    "required": [
        "header",
        "body"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ICG Data",
    "description": "This schema represents impedance cardiography (ICG) waveform data with signal quality and temporal context",
    "type": "object",

    "definitions": {
        "time_frame": {
            "$ref": "time-frame-1.0.json"
        },
        "time_interval": {
            "$ref": "time-interval-1.0.json"
        }
    },

    "properties": {
        "icg": {
            "description": "Raw or filtered ICG values",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "signal_quality": {
            "description": "Signal quality score, from 0 (poor) to 1 (excellent)",
            "type": "array",
            "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            }
        },
        "unit": {
            "type": "string",
            "enum": ["Ω", "mΩ", "counts"]
        },
        "effective_time_frame": {
            "description": "The time interval at which, or time interval during which the measurement is asserted as being valid.",
            "allOf": [
                {
                    "$ref": "#/definitions/time_frame"
                },
                {
                    "required": [
                        "time_interval"
                    ]
                }
            ]
        }
    },
    "required": [
        "icg",
        "unit",
        "effective_time_frame"
    ]
}

{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PPG Data",
    "description": "This schema represents photoplethysmography (PPG) waveform data with signal quality and temporal context",
    "type": "object",

    "definitions": {
        "time_frame": {
            "$ref": "time-frame-1.0.json"
        },
        "time_interval": {
            "$ref": "time-interval-1.0.json"
        }
    },

    "properties": {
        "ac_component": {
            "description": "AC component of the signal, [samples]x[wavelengths]. Each sample may have one value per wavelength.",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "dc_component": {
            "description": "DC component of the signal, [samples]x[wavelengths]. Each sample may have one value per wavelength.",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "ppg": {
            "description": "Raw or filtered PPG signal, [samples]x[wavelengths]",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "signal_quality": {
            "description": "Signal quality score, from 0 (poor) to 1 (excellent)",
            "type": "array",
            "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            }
        },
        "unit": {
            "type": "string",
            "enum": ["counts", "mV", "µV", "RLU"]
        },
        "effective_time_frame": {
            "description": "The time interval at which, or time interval during which the measurement is asserted as being valid.",
            "allOf": [
                {
                    "$ref": "#/definitions/time_frame"
                },
                {
                    "required": [
                        "time_interval"
                    ]
                }
            ]
        }
    },
    "required": [
        "ppg",
        "unit",
        "effective_time_frame"
    ]
}

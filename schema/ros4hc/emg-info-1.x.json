{
    "$schema": "http://json-schema.org/draft-07/schema#",

    "title": "EMG Data Series",
    "type": "object",
    "description": "This schema represents an emg data series, i.e., an array of measures that share the same header.",

    "definitions": {
        "header": {
            "$ref": "sensor-device-header-1.x.json"
        },

        "emg_body": {
            "$ref": "emg-1.x.json"
        },

        "filter_base": {
            "$ref": "filter-base-1.x.json"
        }
    },

    "properties": {
        "header": {
            "description": "The header of the data point.",
            "type": "object",
            "allOf": [
                {"$ref": "#/definitions/header"},
                {
                    "type": "object",
                    "properties": {
                        "emg_info": {
                            "type": "object",
                            "properties": {
                                "electrode_placement": {
                                    "description": "Support multiple placements",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "biceps", "triceps", "forearm", "calf", "back", "abdomen",
                                            "quadriceps", "hamstring", "face", "neck", "custom"
                                        ]
                                    }
                                },

                                "electrode_type": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "surface", "needle", "wire", "interferential", "custom"
                                        ]
                                    }
                                },

                                "external_devices": {
                                    "description": "External devices used during EMG recording",
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "enum": [
                                            "tens", "fes", "emg_trigger", "custom"
                                        ]
                                    }
                                },

                                "signal_mode": {
                                    "type": "string",
                                    "enum": [
                                        "surface", "intramuscular", "custom"
                                    ]
                                },

                                "filters": {
                                    "$ref": "#/definitions/filter_base"
                                }
                            }
                        }
                    }
                }
            ]
        },
        "body": {
            "$ref": "#/definitions/emg_body"
        }
    },

    "required": [
        "header",
        "body"
    ]
}

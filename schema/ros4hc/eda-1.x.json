{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EDA Data",
    "description": "This schema represents electrodermal activity (EDA) waveform data with signal quality and temporal context",
    "type": "object",

    "definitions": {
        "time_frame": {
            "$ref": "time-frame-1.0.json"
        },
        "time_interval": {
            "$ref": "time-interval-1.0.json"
        }
    },

    "properties": {
        "scl": {
            "description": "Skin Conductance Level (tonic component). Empty if not provided by the device.",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "scr": {
            "description": "Skin Conductance Response (phasic component). Empty if not provided by the device.",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "eda": {
            "description": "Sum of signals (scl + scr)",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "signal_quality": {
            "description": "Signal quality score, from 0 (poor) to 1 (excellent)",
            "type": "array",
            "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            }
        },
        "unit": {
            "type": "string",
            "enum": ["uS"]
        },
        "effective_time_frame": {
            "description": "The time interval at which, or time interval during which the measurement is asserted as being valid.",
            "allOf": [
                {
                    "$ref": "#/definitions/time_frame"
                },
                {
                    "required": [
                        "time_interval"
                    ]
                }
            ]
        }
    },
    "required": [
        "eda",
        "unit",
        "effective_time_frame"
    ]
}

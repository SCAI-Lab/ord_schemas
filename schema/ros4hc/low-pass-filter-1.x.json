{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Low-Pass Filter",
    "description": "This schema represents the parameters of a low-pass filter applied to a signal.",
    "type": "object",

    "properties": {
        "cutoff_frequency": {
            "description": "Cutoff frequency, in Hz",
            "type": "number"
        },
        "order": {
            "description": "Filter order (e.g., 2, 4)",
            "type": "integer"
        },
        "sampling_rate": {
            "description": "Sampling rate, in Hz",
            "type": "number"
        }
    },

    "required": [
        "cutoff_frequency",
        "order",
        "sampling_rate"
    ]
}

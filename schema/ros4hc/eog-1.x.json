{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "EOG Data",
    "description": "This schema represents EOG waveform data with signal quality and temporal context",
    "type": "object",

    "definitions": {
        "time_frame": {
            "$ref": "time-frame-1.0.json"
        },
        "time_interval": {
            "$ref": "time-interval-1.0.json"
        }
    },

    "properties": {
        "eog": {
            "description": "Raw or filtered EOG values [channel]x[sample]",
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "signal_quality": {
            "description": "Signal quality score, from 0 (poor) to 1 (excellent)",
            "type": "array",
            "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
            }
        },
        "unit": {
            "type": "string",
            "enum": ["µV", "mV", "counts"]
        },
        "effective_time_frame": {
            "description": "The time interval at which, or time interval during which the measurement is asserted as being valid.",
            "allOf": [
                {
                    "$ref": "#/definitions/time_frame"
                },
                {
                    "required": [
                        "time_interval"
                    ]
                }
            ]
        }
    },
    "required": [
        "eog",
        "unit",
        "effective_time_frame"
    ]
}
